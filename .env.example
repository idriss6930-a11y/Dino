# ─────────────────────────────────────────────────────────────────────────────
# DINO — configuration. Copiez ce fichier en .env.local et remplissez ce dont vous avez besoin.
# Sans AUCUNE variable, DINO démarre en mode démonstration complet (données fictives clairement marquées).
# Ne commitez jamais .env.local : il est ignoré par git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# URL publique (liens dans les e-mails et les notifications push).
APP_URL=http://localhost:3000

# ── Base de données ──────────────────────────────────────────────────────────
# Vide → PGlite (PostgreSQL embarqué) dans ./.data/pglite, rien à installer, un seul processus.
# postgres://user:motdepasse@hote:5432/dino → PostgreSQL (recommandé en production).
# memory:// → base en mémoire (tests).
DATABASE_URL=
# Dossier PGlite si DATABASE_URL est vide.
PGLITE_DIR=
# PostgreSQL : appliquer les migrations au démarrage (true par défaut). Mettre false si vous lancez npm run db:migrate vous-même.
DB_AUTO_MIGRATE=true
DB_POOL_MAX=10

# ── Mode de données ──────────────────────────────────────────────────────────
# auto (défaut) : réel si au moins une clé fournisseur est présente, sinon démo.
# demo : force les données fictives. live : force les fournisseurs réels (résultats vides sans clé).
# Démo et réel ne sont jamais mélangés dans une même réponse.
DINO_DATA_MODE=auto
# Délai maximal d'un appel fournisseur, en millisecondes.
PROVIDER_TIMEOUT_MS=12000

# ── Vols ─────────────────────────────────────────────────────────────────────
# Duffel (https://duffel.com) : offres en temps réel. Un jeton duffel_test_… donne des offres de TEST, marquées comme telles.
DUFFEL_API_TOKEN=
# Travelpayouts / Aviasales Data API (https://www.travelpayouts.com) : prix récents en cache + liens affiliés.
TRAVELPAYOUTS_TOKEN=
# Votre identifiant d'affilié (marker), ajouté aux liens de réservation.
TRAVELPAYOUTS_MARKER=

# ── Hôtels ───────────────────────────────────────────────────────────────────
# LiteAPI (https://www.liteapi.travel) : tarifs et disponibilités. Une clé sand_… donne des données sandbox, marquées.
LITEAPI_KEY=
# Nationalité du voyageur (ISO 3166-1 alpha-2), exigée par les fournisseurs hôteliers.
LITEAPI_GUEST_NATIONALITY=FR

# ── Assistant IA (Claude) ────────────────────────────────────────────────────
# Clé gardée côté serveur uniquement. Sans clé, l'assistant fonctionne en mode « analyse automatique ».
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high : effort de raisonnement (coût et latence).
ANTHROPIC_EFFORT=low

# ── Taux de change ───────────────────────────────────────────────────────────
# frankfurter (taux BCE, sans clé, par défaut) ou builtin (table fixe, hors ligne, affichée comme approximative).
FX_PROVIDER=frankfurter

# ── E-mails ──────────────────────────────────────────────────────────────────
# Ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
# Sans SMTP : en développement les e-mails sont écrits dans le terminal, en production ils ne partent pas.
SMTP_URL=
MAIL_FROM="DINO <no-reply@exemple.com>"

# ── Notifications push (Web Push) ────────────────────────────────────────────
# Générez une paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com

# ── Tâches planifiées ────────────────────────────────────────────────────────
# Le serveur vérifie les alertes chaque minute. off pour le désactiver (worker séparé ou cron externe).
DINO_SCHEDULER=on
# Secret (16 caractères minimum) pour POST /api/cron/alerts avec l'en-tête Authorization: Bearer <secret>.
CRON_SECRET=
# npm run worker refuse de tourner sur PGlite (fichier verrouillé par le serveur). Forcer à vos risques : true.
WORKER_FORCE=

# ── Développement local ──────────────────────────────────────────────────────
# Autorise les cookies de session sans HTTPS avec npm start en local. JAMAIS en production.
INSECURE_COOKIES=

# ── Données de démonstration (npm run db:seed) ───────────────────────────────
# Mot de passe du compte demo@dino.example. Vide → généré aléatoirement et affiché une seule fois.
DEMO_SEED_PASSWORD=
# Crée ou promeut un administrateur (modération, rafraîchissement du climat).
ADMIN_EMAIL=
ADMIN_PASSWORD=
