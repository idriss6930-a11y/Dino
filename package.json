{
  "name": "dino",
  "version": "0.1.0",
  "private": true,
  "description": "DINO — le compagnon de voyage intelligent",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "climate:refresh": "tsx scripts/climate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.11",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
