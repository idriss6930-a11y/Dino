# Placard — configuration. Copiez en .env.local et remplissez ce dont vous avez besoin.
# Sans AUCUNE variable, tout démarre en mode démonstration : rédaction par règles, pas de paiement, pas d'eBay.

# URL publique du site (liens des e-mails, retours Stripe et eBay, adresses des photos pour eBay).
APP_URL=http://localhost:3100
# Au moins 32 caractères aléatoires. Sert à chiffrer les jetons eBay. Ne le changez plus ensuite.
APP_SECRET=

# Base de données : vide → PGlite dans ./.data/pglite ; postgres://… → PostgreSQL ; memory:// → tests.
DATABASE_URL=

# Rédaction par IA (https://console.anthropic.com). Sans clé : rédaction par règles, sans lecture des photos.
ANTHROPIC_API_KEY=
# Modèle utilisé. Voir « Coût de l'IA » dans le README avant de changer ou de lancer.
PLACARD_AI_MODEL=claude-opus-5-5

# Abonnement Premium (https://dashboard.stripe.com). Les trois sont nécessaires.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Texte du prix affiché ; doit correspondre au tarif créé dans Stripe.
PLACARD_PRICE_LABEL=9,90 € par mois

# Publication eBay (https://developer.ebay.com). EBAY_ENV=sandbox pour le bac à sable.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENV=production

# E-mails (réinitialisation du mot de passe). Ex. smtps://user:motdepasse@smtp.exemple.com:465
SMTP_URL=
MAIL_FROM=Placard <no-reply@votre-domaine.fr>

# Mentions légales affichées sur /conditions.
PLACARD_LEGAL_NAME=
PLACARD_LEGAL_CONTACT=
