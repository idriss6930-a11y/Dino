{
  "name": "placard",
  "version": "0.1.0",
  "private": true,
  "description": "Placard — l'assistant d'annonces pour la revente de seconde main",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
