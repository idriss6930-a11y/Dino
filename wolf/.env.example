# THE WOLF — variables d'environnement. Copier en .env (jamais commité) ou en secrets GitHub Actions.
# Aucune valeur réelle ne doit apparaître dans ce fichier.

# Shopify : Admin > Paramètres > Applications > Développer des applications > créer une app personnalisée.
# Droits en LECTURE uniquement : read_orders, read_products, read_inventory, read_shipping,
# read_online_store_pages, read_reports. Aucun droit d'écriture n'est nécessaire.
SHOPIFY_SHOP_DOMAIN=votre-boutique.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Meta (optionnel) : Business Manager > Utilisateurs système > jeton avec le seul droit ads_read.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# Alertes (optionnel) : URL de webhook Discord ou Slack recevant les alertes critiques.
ALERT_WEBHOOK_URL=

# true tant que le fournisseur expédie lui-même (DSers/AliExpress).
WOLF_DROPSHIPPING=true
